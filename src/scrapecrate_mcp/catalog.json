    {
      "id": "ads",
      "name": "Meta Ad Library API",
      "tagline": "Search the ads running on Facebook and Instagram, with creatives, dates and advertiser.",
      "endpoints": [
        {
          "id": "ads-search",
          "path": "/v1/ads/search",
          "summary": "Search ads",
          "description": "Ads matching a keyword or an advertiser page, with filters, up to 30 per call. Every ad carries days_active (whole days from started_at to ended_at, or to today while it runs; null when unknown) and winning_score (0-100, null when days_active is null): long-running ads are the ones that pay off. score = L + V + R, with L = 70 x min(days_active, 90) / 90, V = 15 x min(variants_count - 1, 9) / 9 and R = 15 x min(log10(1 + EU reach) / 6, 1). The EU reach is only in the single-ad lookup, so in lists score = (L + V) x 100 / 85: a missing reach never lowers it. Rounded to the nearest integer. min_days_active and sort=longevity apply to the ads of the returned page, at the same price.",
          "list": true,
          "require_one_of": [
            "q",
            "page_id"
          ],
          "pricing": {
            "unit": "call",
            "credits": 5,
            "limit_param": null
          },
          "params": [
            {
              "name": "q",
              "in": "query",
              "type": "string",
              "required": false,
              "description": "Keyword (required unless `page_id` is set)"
            },
            {
              "name": "page_id",
              "in": "query",
              "type": "string",
              "required": false,
              "description": "Only ads of this advertiser page"
            },
            {
              "name": "country",
              "in": "query",
              "type": "string",
              "required": false,
              "description": "Two-letter country code or `ALL`",
              "default": "ALL"
            },
            {
              "name": "status",
              "in": "query",
              "type": "enum",
              "required": false,
              "description": "Ad status",
              "values": [
                "active",
                "inactive",
                "all"
              ],
              "default": "active"
            },
            {
              "name": "ad_type",
              "in": "query",
              "type": "enum",
              "required": false,
              "description": "All ads or political/issue ads",
              "values": [
                "all",
                "political"
              ],
              "default": "all"
            },
            {
              "name": "media_type",
              "in": "query",
              "type": "enum",
              "required": false,
              "description": "Creative type",
              "values": [
                "all",
                "image",
                "video",
                "meme",
                "none"
              ],
              "default": "all"
            },
            {
              "name": "platforms",
              "in": "query",
              "type": "string",
              "required": false,
              "description": "Comma-separated: facebook, instagram, messenger, audience_network"
            },
            {
              "name": "languages",
              "in": "query",
              "type": "string",
              "required": false,
              "description": "Comma-separated ISO 639-1 codes"
            },
            {
              "name": "active_from",
              "in": "query",
              "type": "date",
              "required": false,
              "description": "Running on or after (YYYY-MM-DD)"
            },
            {
              "name": "active_to",
              "in": "query",
              "type": "date",
              "required": false,
              "description": "Running on or before (YYYY-MM-DD)"
            },
            {
              "name": "match",
              "in": "query",
              "type": "enum",
              "required": false,
              "description": "Keyword match",
              "values": [
                "any",
                "exact"
              ],
              "default": "any"
            },
            {
              "name": "sort",
              "in": "query",
              "type": "enum",
              "required": false,
              "description": "Order; `longevity` puts the longest-running ads of the page first",
              "values": [
                "relevance",
                "impressions",
                "longevity"
              ],
              "default": "relevance"
            },
            {
              "name": "min_days_active",
              "in": "query",
              "type": "integer",
              "required": false,
              "description": "Keep only ads running for at least this many days (applied to the returned page, same price)",
              "min": 0,
              "max": 3650
            },
            {
              "name": "limit",
              "in": "query",
              "type": "integer",
              "required": false,
              "description": "Ads per page (max 30, one page of the source)",
              "min": 1,
              "max": 30,
              "default": 30
            },
            {
              "name": "cursor",
              "in": "query",
              "type": "string",
              "required": false,
              "description": "`pagination.next_cursor` of the previous page"
